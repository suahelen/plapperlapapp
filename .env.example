# PostgreSQL connection string (local Postgres, Docker, or later Supabase)
DATABASE_URL=postgres://vocab:vocab@localhost:5432/plapperlapapp?sslmode=disable

# Long random string (e.g. `openssl rand -hex 32`). Used to HMAC session tokens.
SESSION_SECRET=change-me-to-a-long-random-string

# Public base URL of the site
APP_BASE_URL=http://localhost:5173

# Port the Go API listens on
HTTP_PORT=8080

# Set to true when served over HTTPS (production)
COOKIE_SECURE=false

# Set to true when running behind Caddy/nginx so X-Forwarded-For is trusted for rate limiting
TRUST_PROXY=false

# Where `server migrate` finds the SQL migrations
MIGRATIONS_PATH=../database/migrations

# Speech-to-text sidecar (asr/) for spoken answers; leave empty to disable speech input
ASR_URL=http://127.0.0.1:8765

# Optional: separate database used by `go test` integration tests
# TEST_DATABASE_URL=postgres://vocab:vocab@localhost:5432/plapperlapapp_test?sslmode=disable

# --- Docker Compose only ---
POSTGRES_USER=vocab
POSTGRES_PASSWORD=change-me
POSTGRES_DB=plapperlapapp
# Domain for Caddy (enables automatic HTTPS), or :80 for plain HTTP
SITE_ADDRESS=:80

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel > Configure).
# Only needed to start the `cloudflared` service (profile "public"):
#   docker compose --profile public up -d cloudflared
# Treat this like a password: it grants ingress into the stack. Never commit it.
TUNNEL_TOKEN=
